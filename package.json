{
  "name": "Booper",
  "version": "1.0.0",
  "description": "Send disappearing photos and videos that can only be viewed once",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wrangler pages dev public --port 3001\"",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev dist/client",
    "deploy": "npm run build && wrangler pages deploy dist/client"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RogerPodacter/booper"
  },
  "keywords": ["disappearing-messages", "privacy", "e2e-encryption", "cloudflare"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "wrangler": "^4.54.0"
  }
}
